{
  "name": "todo-web-styles",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i ./input.css -o ../static/style.css --minify && mkdir -p ../static/js && cp node_modules/htmx.org/dist/htmx.min.js ../static/js/htmx.min.js",
    "watch": "tailwindcss -i ./input.css -o ../static/style.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4",
    "htmx.org": "^2",
    "tailwindcss": "^4"
  }
}
